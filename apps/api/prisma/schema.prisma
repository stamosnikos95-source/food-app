// Minimal M0 schema: only what auth + profile skeleton needs.
// Menu, orders, payments, inventory etc. are added in later milestones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  staff
  admin
  gym_partner
  corporate_admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(customer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       CustomerProfile?
  orders        Order[]
  refreshTokens RefreshToken[]
  companyMembership CompanyMember?

  @@map("users")
}

model CustomerProfile {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                 Int?
  gender              String?
  heightCm            Int?
  weightKg            Float?
  activityLevel       String?
  goal                String?
  budgetPerMealCents  Int?
  dietaryPreferences  String[] @default([])
  excludedIngredients String[] @default([])
  excludedAllergens   String[] @default([])
  updatedAt           DateTime @updatedAt

  @@map("customer_profiles")
}

model MenuItem {
  id             String   @id @default(uuid())
  name           String
  description    String?
  priceCents     Int
  portionWeightG Int
  calories       Int
  proteinG       Float
  carbsG         Float
  fatG           Float
  imageUrl       String?
  // EU 1169/2011 allergen codes (see ALLERGENS in @food-app/shared-types).
  allergens      String[] @default([])
  // Explicit admin labels (see DIET_TAGS); recommendations rely on them.
  dietTags       String[] @default([])
  category       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems     OrderItem[]
  recipe         Recipe?
  productionRuns ProductionRun[]
  dishWaste      DishWaste[]
  forecasts      DemandForecast[]

  @@map("menu_items")
}

enum OrderStatus {
  pending
  confirmed
  ready
  completed
  cancelled
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(pending)
  totalPriceCents Int
  // Employer subsidy (M6): the share of this order paid by the customer's
  // company, invoiced monthly. The customer pays totalPriceCents - this.
  companyId        String?
  company          Company?    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyPaidCents Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([companyId, createdAt])

  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id])
  quantity       Int
  unitPriceCents Int


  @@index([orderId])
  @@map("order_items")
}

// Opaque, single-use refresh tokens. Only a SHA-256 hash is stored, so a
// database leak doesn't hand out usable sessions. Each refresh revokes the
// presented token and issues a new one (rotation); presenting an already
// revoked token is treated as theft and revokes every session of that user.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
}

// One row per checkout attempt. An order can have several attempts (e.g. the
// customer abandoned one and retried); at most one can succeed because every
// new attempt first closes the previous open ones.
model Payment {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider    String
  // Provider-side id (Stripe Checkout Session id). Null only in the short
  // window between creating this row and the provider call returning.
  providerRef String?       @unique
  status      PaymentStatus @default(pending)
  amountCents Int
  currency    String        @default("eur")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@map("payments")
}

// Who changed what, for staff/admin actions (order status, menu edits, ...).
// No foreign key on purpose: the trail must outlive the accounts it mentions.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---- Kitchen costing (M5): ingredients -> recipes -> menu items ----------

// Nutrition is per 100 g of the ingredient as weighed in the recipe; cost is
// the purchase price per kg (per litre is treated as per kg).
model Ingredient {
  id             String   @id @default(uuid())
  name           String   @unique
  costPerKgCents Int
  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float
  allergens      String[] @default([])
  isActive       Boolean  @default(true)
  // Low-stock alert threshold, grams (M7).
  reorderLevelG  Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recipeLines RecipeIngredient[]
  stockMovements StockMovement[]

  @@map("ingredients")
}

// A batch recipe producing `yieldPortions` portions of one menu item.
model Recipe {
  id            String    @id @default(uuid())
  menuItemId    String?   @unique
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name          String
  yieldPortions Int       @default(1)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  grams        Float

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

// ---- Corporate clients (M6) ----------------------------------------------

model Company {
  id                  String   @id @default(uuid())
  name                String
  vatNumber           String   @unique // Greek ΑΦΜ, 9 digits, checksum-validated
  billingEmail        String
  contactName         String?
  phone               String?
  address             String?
  // Paid by the company per employee per calendar day (Europe/Athens).
  dailyAllowanceCents Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members CompanyMember[]
  orders  Order[]

  @@map("companies")
}

// A customer belongs to at most one company (userId is unique).
model CompanyMember {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("company_members")
}

// ---- Inventory, production and forecasting (M7) --------------------------
// Stock is a ledger: the current quantity of an ingredient is the sum of its
// movements, so every change is attributable and nothing is overwritten.

enum StockMovementType {
  purchase
  production
  waste
  adjustment
}

model StockMovement {
  id              String            @id @default(uuid())
  ingredientId    String
  ingredient      Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  type            StockMovementType
  quantityG       Float // signed: + into stock, - out of stock
  costPerKgCents  Int? // purchases: price paid
  expiresOn       String? // purchases: best-before, "YYYY-MM-DD"
  reason          String? // waste: expired | spoiled | overproduction | prep_loss | other
  note            String?
  productionRunId String?
  productionRun   ProductionRun?    @relation(fields: [productionRunId], references: [id], onDelete: Restrict)
  actorId         String?
  createdAt       DateTime          @default(now())

  @@index([ingredientId, createdAt])
  @@index([type, createdAt])
  @@map("stock_movements")
}

model ProductionRun {
  id                  String   @id @default(uuid())
  menuItemId          String
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  businessDate        String // "YYYY-MM-DD", Europe/Athens
  portions            Int
  costPerPortionCents Int? // recipe cost at production time
  actorId             String?
  createdAt           DateTime @default(now())

  stockMovements StockMovement[]

  @@index([businessDate])
  @@index([menuItemId, businessDate])
  @@map("production_runs")
}

// Prepared portions thrown away (unsold at close, quality issues).
model DishWaste {
  id                  String   @id @default(uuid())
  menuItemId          String
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  businessDate        String
  portions            Int
  reason              String // unsold | quality | other
  costPerPortionCents Int?
  actorId             String?
  createdAt           DateTime @default(now())

  @@index([businessDate])
  @@index([menuItemId, businessDate])
  @@map("dish_waste")
}

// What we predicted for a day, kept so forecast accuracy can be measured.
model DemandForecast {
  id           String   @id @default(uuid())
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  businessDate String
  predicted    Float?
  recommended  Int?
  observations Int
  confidence   String
  modelVersion String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([menuItemId, businessDate])
  @@map("demand_forecasts")
}
