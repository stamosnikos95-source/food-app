// Minimal M0 schema: only what auth + profile skeleton needs.
// Menu, orders, payments, inventory etc. are added in later milestones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  staff
  admin
  gym_partner
  corporate_admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(customer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile CustomerProfile?
  orders  Order[]

  @@map("users")
}

model CustomerProfile {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                 Int?
  gender              String?
  heightCm            Int?
  weightKg            Float?
  activityLevel       String?
  goal                String?
  budgetPerMealCents  Int?
  dietaryPreferences  String[] @default([])
  excludedIngredients String[] @default([])
  updatedAt           DateTime @updatedAt

  @@map("customer_profiles")
}

model MenuItem {
  id             String   @id @default(uuid())
  name           String
  description    String?
  priceCents     Int
  portionWeightG Int
  calories       Int
  proteinG       Float
  carbsG         Float
  fatG           Float
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems OrderItem[]

  @@map("menu_items")
}

enum OrderStatus {
  pending
  confirmed
  ready
  completed
  cancelled
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(pending)
  totalPriceCents Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id])
  quantity       Int
  unitPriceCents Int

  @@map("order_items")
}
