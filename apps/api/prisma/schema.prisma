// Minimal M0 schema: only what auth + profile skeleton needs.
// Menu, orders, payments, inventory etc. are added in later milestones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  staff
  admin
  gym_partner
  corporate_admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(customer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       CustomerProfile?
  orders        Order[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model CustomerProfile {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                 Int?
  gender              String?
  heightCm            Int?
  weightKg            Float?
  activityLevel       String?
  goal                String?
  budgetPerMealCents  Int?
  dietaryPreferences  String[] @default([])
  excludedIngredients String[] @default([])
  updatedAt           DateTime @updatedAt

  @@map("customer_profiles")
}

model MenuItem {
  id             String   @id @default(uuid())
  name           String
  description    String?
  priceCents     Int
  portionWeightG Int
  calories       Int
  proteinG       Float
  carbsG         Float
  fatG           Float
  imageUrl       String?
  // EU 1169/2011 allergen codes (see ALLERGENS in @food-app/shared-types).
  allergens      String[] @default([])
  category       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems OrderItem[]
  recipe     Recipe?

  @@map("menu_items")
}

enum OrderStatus {
  pending
  confirmed
  ready
  completed
  cancelled
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(pending)
  totalPriceCents Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId])

  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id])
  quantity       Int
  unitPriceCents Int


  @@index([orderId])
  @@map("order_items")
}

// Opaque, single-use refresh tokens. Only a SHA-256 hash is stored, so a
// database leak doesn't hand out usable sessions. Each refresh revokes the
// presented token and issues a new one (rotation); presenting an already
// revoked token is treated as theft and revokes every session of that user.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
}

// One row per checkout attempt. An order can have several attempts (e.g. the
// customer abandoned one and retried); at most one can succeed because every
// new attempt first closes the previous open ones.
model Payment {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider    String
  // Provider-side id (Stripe Checkout Session id). Null only in the short
  // window between creating this row and the provider call returning.
  providerRef String?       @unique
  status      PaymentStatus @default(pending)
  amountCents Int
  currency    String        @default("eur")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@map("payments")
}

// Who changed what, for staff/admin actions (order status, menu edits, ...).
// No foreign key on purpose: the trail must outlive the accounts it mentions.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---- Kitchen costing (M5): ingredients -> recipes -> menu items ----------

// Nutrition is per 100 g of the ingredient as weighed in the recipe; cost is
// the purchase price per kg (per litre is treated as per kg).
model Ingredient {
  id             String   @id @default(uuid())
  name           String   @unique
  costPerKgCents Int
  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float
  allergens      String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recipeLines RecipeIngredient[]

  @@map("ingredients")
}

// A batch recipe producing `yieldPortions` portions of one menu item.
model Recipe {
  id            String    @id @default(uuid())
  menuItemId    String?   @unique
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name          String
  yieldPortions Int       @default(1)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  grams        Float

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}
